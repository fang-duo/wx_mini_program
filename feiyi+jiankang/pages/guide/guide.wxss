.container {
  min-height: 100vh;
  background: #f6f8f5;
}

.loading-state,
.empty-state {
  padding: 160rpx 48rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2e5a42;
}

.loading-desc,
.empty-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #6c7f70;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0));
}

.hero-title {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.page-title {
  padding: 40rpx 32rpx 12rpx;
  color: #2e5a42;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.content-box {
  padding: 28rpx 24rpx 40rpx;
}

.intro-card,
.section-card,
.tips-card {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(46, 90, 66, 0.06);
}

.intro-title,
.tips-title {
  margin-bottom: 18rpx;
  color: #2e5a42;
  font-size: 32rpx;
  font-weight: 700;
}

.intro-text,
.tips-text {
  color: #4c5b51;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.section-card {
  border: 1rpx solid rgba(46, 90, 66, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(46, 90, 66, 0.1);
  color: #2e5a42;
  font-size: 22rpx;
  font-weight: 600;
}

.section-title {
  flex: 1;
  color: #2e5a42;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}

.section-intro-block,
.section-detail-block {
  margin-top: 18rpx;
}

.section-intro-block:first-of-type,
.section-detail-block:first-of-type {
  margin-top: 0;
}

.section-label {
  margin-bottom: 12rpx;
  color: #7a8a7e;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-intro,
.section-text {
  color: #4c5b51;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.section-intro {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f6f8f5;
}

.section-image {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #eef3ee;
}
