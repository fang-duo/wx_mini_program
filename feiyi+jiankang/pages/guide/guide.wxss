.container {
  min-height: 100vh;
  background: #f6f8f5;
}

.loading-state,
.empty-state {
  padding: 160rpx 48rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2e5a42;
}

.loading-desc,
.empty-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #6c7f70;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0));
}

.hero-title {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.page-title {
  padding: 40rpx 32rpx 12rpx;
  color: #2e5a42;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.content-box {
  padding: 28rpx 24rpx 40rpx;
}

.intro-card,
.section-card,
.tips-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 90, 66, 0.05);
}

.intro-title,
.section-title,
.tips-title {
  margin-bottom: 18rpx;
  color: #2e5a42;
  font-size: 32rpx;
  font-weight: 700;
}

.intro-text,
.section-text,
.tips-text {
  color: #4c5b51;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.section-image {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #eef3ee;
}
