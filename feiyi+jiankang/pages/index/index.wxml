<view class="container">
  <!-- 顶部 Banner/轮播图 -->
  <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}" indicator-color="rgba(255, 255, 255, 0.6)" indicator-active-color="#2E5A42">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item bg-secondary" bindtap="goToDetail" data-title="{{item.title}}" data-item-id="{{item.itemId}}" data-content-type="{{item.contentType}}">
        <image class="banner-img" src="{{item.img}}" mode="aspectFill" wx:if="{{item.img}}" />
        <view class="banner-text">{{item.title}}</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 四大分类模块 -->
  <view class="section">
    <view class="section-title">非遗传承</view>
    <view class="category-grid">
      <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goToCategory" data-id="{{item.id}}">
        <view class="icon-wrap">
          <text class="iconfont">{{item.iconText}}</text>
        </view>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 每日推荐 (可选加分) -->
  <view class="section recommend-daily">
    <view class="section-title">每日推荐</view>
    <view class="daily-card">
      <view class="daily-title">{{dailyRecommend.title || '今日推荐'}}</view>
      <view class="daily-desc">{{dailyRecommend.summary || '当前暂无推荐内容。'}}</view>
      <view class="daily-btn" wx:if="{{dailyRecommend.title}}" bindtap="goToDetail" data-title="{{dailyRecommend.title}}" data-item-id="{{dailyRecommend.id}}" data-content-type="{{dailyRecommend.contentType}}">去查看 ></view>
    </view>
  </view>

  <!-- 最新活动与宣传 -->
  <view class="section">
    <view class="section-title">最新活动与宣传</view>
    <view class="article-list">
      <view class="article-item" wx:for="{{articles}}" wx:key="id" bindtap="goToDetail" data-title="{{item.title}}" data-item-id="{{item.id}}" data-content-type="{{item.contentType}}">
        <image class="article-img" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}"></image>
        <view class="article-info">
          <view class="article-title">{{item.title}}</view>
          <view class="article-desc">{{item.desc}}</view>
          <view class="article-meta">
            <text class="tag">{{item.tag}}</text>
            <text class="date">{{item.date}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{articles.length === 0}}">
      <text>当前暂无活动内容。</text>
    </view>
  </view>
</view>
